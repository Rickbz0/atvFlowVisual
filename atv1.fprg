    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="maior" type="Real" array="False" size=""/>
            <output expression="&quot;Insira o seu numero:&quot;" newline="True"/>
            <input variable="maior"/>
            <if expression="maior &gt; 0">
                <then>
                    <output expression="&quot;Numero positivo!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Numero negativo!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>

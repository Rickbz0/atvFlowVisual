    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="multiplo" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira o seu numero:&quot;" newline="True"/>
            <input variable="multiplo"/>
            <if expression="multiplo % 5 == 0">
                <then>
                    <output expression="&quot;Seu numero &#233; multiplo de 5!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Seu numero n&#227;o &#233; multiplo!&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
